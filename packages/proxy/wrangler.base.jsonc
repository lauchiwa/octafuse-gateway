{
	// 模板：由 `npm run gen:wrangler` 生成 `wrangler.jsonc`（勿手改生成文件）。
	// D1 与 Worker 入口。执行 `npm run db:migrate*` 时使用 `packages/core/wrangler.d1.jsonc`（仅 D1，勿 deploy）。
	// 本地 dev：生成文件应无 database_id（`(DB)` 本地库）。远程 deploy 后会写入 database_id — 继续本地 dev 前须再跑 npm run gen:wrangler。
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "octafuse-gateway-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	// 保留 `*.workers.dev` 作为备用入口：绑定 Custom Domain 后 Cloudflare 默认关闭子域，
	// 显式置 true 才能两个入口共存（自定义域名失效时不致于完全失联）。
	"workers_dev": true,
	// 不需要逐版本的公网 preview 地址：workers_dev 为 true 时 Cloudflare 会默认开启 Preview URLs，
	// 每个已部署版本都多出一个不受访问控制约束的入口，对网关/管理面是多余暂露面。
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "octafuse-gateway"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
